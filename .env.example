# =============================================================================
# TwitchSync — Environment Variables
# Copy this file and fill in your values:
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Or run the helper: ./scripts/generate-env.sh
# =============================================================================

# ── Public URL (the single source of truth) ───────────────────────────────────
# Set this to exactly how users reach TwitchSync in their browser.
# FRONTEND_URL, CORS_ORIGIN, and TWITCH_REDIRECT_URI all derive from this.
#
#   Local:          http://localhost:2261
#   Homelab by IP:  http://192.168.1.100:2261
#   Domain:         https://twitchsync.example.com
#
PUBLIC_URL=http://YOUR_SERVER_IP:2261

# ── Twitch API ────────────────────────────────────────────────────────────────
# Get these from https://dev.twitch.tv/console → your application
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Must EXACTLY match what you registered in the Twitch dev console.
# Should always be:  ${PUBLIC_URL}/auth/twitch/callback
TWITCH_REDIRECT_URI=http://YOUR_SERVER_IP:2261/auth/twitch/callback

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=twitchsync
DB_USER=twitchsync
DB_PASSWORD=changeme_use_a_strong_password

# Set DB_SSL=true only if connecting to an external managed Postgres (e.g. RDS, Supabase)
# Leave false for the bundled Docker postgres container
DB_SSL=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── Storage ───────────────────────────────────────────────────────────────────
# Path INSIDE the container where VODs are saved.
STORAGE_PATH=/data/vods

# Optional host path to mount for VOD storage (left side of docker volume mount).
# Leave blank to use the Docker-managed `vod_storage` volume.
# e.g. /mnt/media/TwitchSync  or  /srv/vods
VOD_STORAGE_HOST_PATH=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3501

# Optional — defaults to PUBLIC_URL if not set
# FRONTEND_URL=http://YOUR_SERVER_IP:2261
# CORS_ORIGIN=http://YOUR_SERVER_IP:2261

# Frontend port (default 2261)
# FRONTEND_PORT=2261

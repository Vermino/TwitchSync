# Frontend Environment Variables
VITE_API_URL=http://localhost:2261/api
VITE_TWITCH_CLIENT_ID=your_twitch_client_id_here
VITE_TWITCH_REDIRECT_URI=http://localhost:2261/auth/twitch/callback
VITE_WS_URL=

# Note: VITE_TWITCH_CLIENT_ID is visible in the browser bundle — this is safe for OAuth apps.
# The Twitch Developer Console restricts which redirect URIs are valid.
# In Docker/local compose, Twitch should redirect to the public frontend origin:
#   http://localhost:2261/auth/twitch/callback
# VITE_WS_URL is optional; when omitted, the frontend uses the current origin.
